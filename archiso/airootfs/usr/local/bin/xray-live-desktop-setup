#!/usr/bin/env bash
# Automatically ensure the Calamares installer icon is present and trusted on the live desktop

DESKTOP_DIR="${HOME}/Desktop"
mkdir -p "$DESKTOP_DIR"

for desktop_file in /usr/share/applications/xray-installer.desktop /etc/skel/Desktop/xray-installer.desktop; do
    if [[ -f "$desktop_file" ]]; then
        base_name="$(basename "$desktop_file")"
        if [[ ! -f "$DESKTOP_DIR/$base_name" ]]; then
            cp -f "$desktop_file" "$DESKTOP_DIR/"
        fi
    fi
done

# Ensure executable permissions and trusted status
chmod +x "$DESKTOP_DIR"/*.desktop 2>/dev/null || true

if command -v gio >/dev/null 2>&1; then
    for f in "$DESKTOP_DIR"/*.desktop; do
        [[ -f "$f" ]] && gio set "$f" metadata::trusted true 2>/dev/null || true
    done
fi
